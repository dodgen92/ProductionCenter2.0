# Copy this file to .env and fill in your own values. Never commit .env.

# Twitch app (Server.py, clips.py, unsubscribe.py)
TWITCH_CLIENT_ID=
# Broadcaster user access token. EventSub WebSocket needs this user token.
# An app access token will not work. Scopes are listed in the README.
TWITCH_OAUTH_TOKEN=
# App client secret from the Twitch developer console (clips.py and Play a Clip).
# If blank, clips.py uses SECRET.
TWITCH_CLIENT_SECRET=
SECRET=
# Optional. Blank connects to Twitch's EventSub WebSocket.
# Set a local mock address here only while you are testing.
EVENTSUB_WS_URL=
# Channel point reward title for Play a Clip. Blank means Play a Clip.
CLIP_REWARD_TITLE=
# Optional override for the HTML widgets. Blank serves the widgets/ folder in this repo.
# Set a path only if your widgets live somewhere else.
# A relative path is inside this project. The old folder was C:\Users\tyler\Desktop\Stream-Widgets
WIDGETS_DIR=

# Twitch user + broadcaster (archive.py, Server.py)
USER_CLIENT_ID=
USER_OAUTH_TOKEN=
BROADCASTER_USER_ID=

# Discord (archive.py)
DISCORD_CLIP_WEBHOOK_URL=

# OBS WebSocket (Pokemon\pokerip.py, getobssceneitems.py)
OBS_HOST=
OBS_PORT=
OBS_PASSWORD=

# Benito Santiago and Ask the Monk share this Gemini key. Never commit a value.
GEMINI_API_KEY=
# Ask the Monk. Blank uses the defaults: gemini-2.5-flash-lite, 60 seconds, 100 calls/day.
COUNSEL_MODEL=
COUNSEL_USER_COOLDOWN=
COUNSEL_DAILY_CAP=
# Shared Gemini calls per local day (monk + Benito). Blank means 900, under a 1000/day free tier.
# Lull Helper counts toward this same number. The number is this app's stop. It does not mean Google will accept the call.
GEMINI_PROJECT_DAILY_CAP=

# Lull Helper. Placeholders only. Put real values in .env, never in git or chat.
# Local secret for POST /lull and POST /lull/mic. Stream Deck sends it as the header X-Lull-Token.
# Blank means those routes refuse. The F9 hotkey does not use this header.
LULL_TRIGGER_TOKEN=
# Discord bot token for the DM. Not the clip webhook. Blank means a trigger does not call Gemini.
LULL_DISCORD_TOKEN=
# Tyler's Discord user id. The bot DMs only this id.
LULL_DISCORD_USER_ID=
# Hotkey. Blank means f9. The keyboard hook fires while WoW is focused.
LULL_HOTKEY=
# faster-whisper model: base or small. Blank means base. Downloaded only when the mic worker starts.
LULL_WHISPER_MODEL=
# Optional device name or index. Blank means the default input.
LULL_MIC_DEVICE=
# Optional cpu or cuda. Blank means cpu.
LULL_WHISPER_DEVICE=
# Seconds after a trigger before the next one runs. Blank means 15.
LULL_COOLDOWN=
# Lull Gemini calls per local day, before the shared project cap. Blank means 40.
LULL_DAILY_CAP=
# Blank means gemini-2.5-flash.
LULL_MODEL=

# Optional. Blank keeps free edge-tts. Set both to use ElevenLabs on /tts?engine=eleven.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# Optional. Blank skips DeepL. /translate tries Google, then MyMemory, then DeepL.
DEEPL_API_KEY=
