# Copy this file to .env and fill in your own values. Never commit .env.

# Twitch app (Server.py, clips.py, unsubscribe.py)
TWITCH_CLIENT_ID=
TWITCH_OAUTH_TOKEN=
# Webhook signing secret (10 to 100 characters). If blank, Server.py uses SECRET.
EVENTSUB_SECRET=
# App client secret from the Twitch developer console (clips.py and Play a Clip).
# If blank, clips.py uses SECRET. SECRET used to do both jobs; split them when you can.
TWITCH_CLIENT_SECRET=
SECRET=
WEBHOOK_URL=
# Channel point reward title for Play a Clip. Blank means Play a Clip.
CLIP_REWARD_TITLE=
# Absolute path to your HTML widgets. Blank until you set one.
# On Tyler's PC that folder is C:\Users\tyler\Desktop\Stream-Widgets
WIDGETS_DIR=

# Twitch user + broadcaster (archive.py, Server.py)
USER_CLIENT_ID=
USER_OAUTH_TOKEN=
BROADCASTER_USER_ID=

# Discord (archive.py)
DISCORD_CLIP_WEBHOOK_URL=

# OBS WebSocket (Pokemon\pokerip.py, getobssceneitems.py)
OBS_HOST=
OBS_PORT=
OBS_PASSWORD=

# Benito Santiago (Gemini)
GEMINI_API_KEY=

# Optional. Blank keeps free edge-tts. Set both to use ElevenLabs on /tts?engine=eleven.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# Optional. Blank skips DeepL. /translate tries Google, then MyMemory, then DeepL.
DEEPL_API_KEY=
