# Environment variables
.env
.env.*
!.env.example

# Python virtual environment
venv/
.venv/
.venv-voice/

# Python cache
__pycache__/
*.py[cod]
.pytest_cache/

# IDE
.vscode/
.idea/

# Spoken audio and per-stream credits (viewer names)
tts_cache/
stream_credits.json
gemini_usage.json

# Downloaded Twitch clips. Keep the folder marker, not the videos or the index.
clips_cache/*
!clips_cache/.gitkeep

# Recorded presenter lines. Keep the folder README and .gitkeep.
voice_lines/*
!voice_lines/orc/
voice_lines/orc/*
!voice_lines/orc/.gitkeep
!voice_lines/orc/README.md

# Generated Fact Gnome wavs from make_gnome_voices.py stay on this PC.
# Shipped lines (voice/voices.js and gnome_01.mp3–gnome_25.mp3) are tracked.
widgets/fact-gnome/voice/*
!widgets/fact-gnome/voice/voices.js
!widgets/fact-gnome/voice/*.mp3

# Local test notes. Do not commit.
tests.txt


voice_env/